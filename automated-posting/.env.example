# Copy this file to .env and fill only the credentials for accounts you control.

# Mastodon: instance base URL and user access token with write:statuses scope
MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# Bluesky: handle/email and an app password (not your main account password)
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=

# Telegram: create bot with @BotFather, add it as channel admin, use @channelusername or numeric chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHANNEL_USERNAME=

# Discord: create an incoming webhook in a channel you administer
DISCORD_WEBHOOK_URL=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# WordPress: HTTPS site URL, username, Application Password
WORDPRESS_SITE_URL=
WORDPRESS_USERNAME=
WORDPRESS_APPLICATION_PASSWORD=
WORDPRESS_POST_TITLE=Automated update
